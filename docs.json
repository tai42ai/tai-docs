{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TAI42",
  "description": "tai is an open-source runtime for MCP tools, agents, and workflows — the server that hosts tools, agents, extensions, connectors, hooks, and storage for the TAI42 ecosystem.",
  "colors": {
    "primary": "#DC143C",
    "light": "#F4718A",
    "dark": "#A01030"
  },
  "favicon": {
    "light": "/logo/icon.png",
    "dark": "/logo/icon-dark.png"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Geist"
    },
    "body": {
      "family": "Inter"
    }
  },
  "search": {
    "prompt": "Search the TAI42 docs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
